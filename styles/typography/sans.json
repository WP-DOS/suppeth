{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Sans",
  "slug": "sans",
  "styles": {
    "typography": {
      "fontFamily": "var:preset|font-family|dm-sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontWeight": "400",
          "lineHeight": "1.3"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontWeight": "400"
        }
      }
    }
  }
}
