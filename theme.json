{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "base",
          "name": "Background",
          "color": "#ffffff"
        },
        {
          "slug": "contrast",
          "name": "Text",
          "color": "#444444"
        },
        {
          "slug": "muted",
          "name": "Secondary",
          "color": "#686868"
        },
        {
          "slug": "accent",
          "name": "Links",
          "color": "#174ea6"
        },
        {
          "slug": "surface",
          "name": "Subtle background",
          "color": "#f6f7f8"
        },
        {
          "slug": "border",
          "name": "Borders",
          "color": "#e7e7e7"
        },
        {
          "slug": "control-border",
          "name": "Control borders",
          "color": "#888888"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Small",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Large",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "Section",
          "size": "clamp(2rem, 5vw, 4rem)"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "source-serif-4",
          "name": "Source Serif 4",
          "fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Source Serif 4",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-serif-4-normal-latin.woff2"
              ]
            },
            {
              "fontFamily": "Source Serif 4",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-serif-4-italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "cormorant-garamond",
          "name": "Cormorant Garamond",
          "fontFamily": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/cormorant-garamond-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "system",
          "name": "System sans",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "dm-sans",
          "name": "DM Sans",
          "fontFamily": "\"DM Sans\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/dm-sans-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "\"Manrope\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/manrope-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "JetBrains Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Consolas, monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jetbrains-mono-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1.125rem",
          "fluid": false
        },
        {
          "slug": "minor-heading",
          "name": "Minor heading",
          "size": "1.25rem",
          "fluid": false
        },
        {
          "slug": "subheading",
          "name": "Subheading",
          "size": "1.375rem",
          "fluid": false
        },
        {
          "slug": "small-heading",
          "name": "Small heading",
          "size": "1.625rem",
          "fluid": {
            "min": "1.5rem",
            "max": "1.625rem"
          }
        },
        {
          "slug": "large",
          "name": "Heading",
          "size": "1.875rem",
          "fluid": {
            "min": "1.75rem",
            "max": "1.875rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Large heading",
          "size": "2.25rem",
          "fluid": {
            "min": "1.875rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Page title",
          "size": "3rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3rem"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|small-heading"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|subheading",
          "fontWeight": "600"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|minor-heading",
          "fontWeight": "600"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|20",
            "bottom": "var:preset|spacing|20",
            "left": "var:preset|spacing|30",
            "right": "var:preset|spacing|30"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono"
        }
      },
      "core/preformatted": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-sidebar",
      "title": "Page with Sidebar",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "single-sidebar",
      "title": "Post with Sidebar",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "index-sidebar",
      "title": "Index with Sidebar",
      "postTypes": []
    },
    {
      "name": "archive-sidebar",
      "title": "Archive with Sidebar",
      "postTypes": []
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "header-search",
      "title": "Header with search",
      "area": "header"
    },
    {
      "name": "header-centered",
      "title": "Centered header",
      "area": "header"
    },
    {
      "name": "header-two-row",
      "title": "Two-row header with search",
      "area": "header"
    },
    {
      "name": "footer-compact",
      "title": "Compact footer",
      "area": "footer"
    },
    {
      "name": "footer-centered",
      "title": "Centered footer",
      "area": "footer"
    },
    {
      "name": "footer-columns",
      "title": "Footer with columns",
      "area": "footer"
    },
    {
      "name": "footer-search",
      "title": "Footer with search",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Sidebar",
      "area": "uncategorized"
    }
  ]
}
