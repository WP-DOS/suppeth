{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1"
  },
  "steps": [
    {
      "step": "activateTheme",
      "themeFolderName": "suppeth"
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-seed.php",
      "data": { "resource": "bundled", "path": "fixtures/seed.php" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-blocks.html",
      "data": { "resource": "bundled", "path": "fixtures/blocks.html" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-typography.html",
      "data": { "resource": "bundled", "path": "fixtures/typography.html" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-landscape.png",
      "data": { "resource": "bundled", "path": "fixtures/landscape.png" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-square.png",
      "data": { "resource": "bundled", "path": "fixtures/square.png" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-thumbnail.png",
      "data": { "resource": "bundled", "path": "fixtures/thumbnail.png" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-site.php",
      "data": { "resource": "bundled", "path": "fixtures/site.php" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-contact.html",
      "data": { "resource": "bundled", "path": "fixtures/contact.html" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-services.html",
      "data": { "resource": "bundled", "path": "fixtures/services.html" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-portfolio.html",
      "data": { "resource": "bundled", "path": "fixtures/portfolio.html" }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/suppeth-demo-contact.php",
      "data": { "resource": "bundled", "path": "fixtures/demo-contact.php" }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/demo-contact.js",
      "data": { "resource": "bundled", "path": "fixtures/demo-contact.js" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-elements-proof.html",
      "data": { "resource": "bundled", "path": "fixtures/elements-proof.html" }
    },
    {
      "step": "writeFile",
      "path": "/tmp/suppeth-typography-proof.html",
      "data": { "resource": "bundled", "path": "fixtures/typography-proof.html" }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/tmp/suppeth-seed.php';"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
  ]
}
